// ─────────────────────────────────────────────
// CULTURE MODULE (Módulo 4)
// ─────────────────────────────────────────────

model CultureConfig {
  id        String @id @default(cuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Etapa 1 — Identidad fundadora
  purpose           String? // Por qué existe (más allá del negocio)
  problem_statement String? // Qué injusticia o ineficiencia combate
  desired_impact    String? // Qué tipo de impacto quiere dejar

  // Etapa 2 — Filosofía operativa (cómo creemos que debe trabajarse)
  operative_philosophy Json? // String[]

  // Etapa 3 — No negociable
  anti_values Json? // {behavior: string, reason: string}[]

  // Etapa 4 — Reconocimiento y feedback
  recognition_behaviors Json? // String[] — comportamientos que se premian
  recognition_awards    Json? // {name: string, description: string, frequency: string}[]
  feedback_framework    Json? // {stages: string[]} — ej: [situación, comportamiento, impacto, mejora]

  // Etapa 5 — Lenguaje interno (glosario corporativo)
  internal_language Json? // {term: string, definition: string}[]

  // Etapa 8 — IA-first
  ai_human_division Json? // {human_tasks: string[], ai_tasks: string[]}
  ai_principles     Json? // String[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  principles CulturePrinciple[]
  rituals    CultureRitual[]
}

model CulturePrinciple {
  id                  String        @id @default(cuid())
  tenant_id           String
  culture_id          String
  tenant              Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  culture             CultureConfig @relation(fields: [culture_id], references: [id], onDelete: Cascade)
  name                String        // ej: "Ownership"
  observable_behavior String        // ej: "Resuelve sin esperar permiso"
  is_active           Boolean       @default(true)
  sort_order          Int           @default(0)
  created_at          DateTime      @default(now())
}

model CultureRitual {
  id               String        @id @default(cuid())
  tenant_id        String
  culture_id       String
  tenant           Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  culture          CultureConfig @relation(fields: [culture_id], references: [id], onDelete: Cascade)
  name             String
  ritual_type      RitualType
  duration_minutes Int?
  description      String?
  agenda           Json?         // {items: {topic: string, minutes?: number}[]}
  is_active        Boolean       @default(true)
  sort_order       Int           @default(0)
  created_at       DateTime      @default(now())
}

enum RitualType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SPECIAL
}

// ─────────────────────────────────────────────
// CULTURE ENGINE — Layers 1-8
// ─────────────────────────────────────────────

// Layer 1 — Founder DNA
model FounderProfile {
  id        String   @id @default(cuid())
  tenant_id String   @unique
  tenant    Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  slot_id   String   // ID del owner

  // Visión
  industry_change String? // ¿Qué quieres cambiar en tu industria?
  differentiator  String? // ¿Qué hace diferente a tu empresa?

  // Filosofía
  loved_behaviors      Json? // String[] — comportamientos que ama en un colaborador
  zero_tolerance       Json? // String[] — lo que jamás toleraría
  hated_inefficiencies Json? // String[] — lo que le desespera del trabajo tradicional
  doing_well_means     String? // ¿Qué significa "hacerlo bien"?

  // Cultura y energía
  team_feeling   String? // ¿Cómo quieres que la gente se sienta aquí?
  client_energy  String? // ¿Qué energía quieres transmitir al cliente?

  // Postura IA
  ai_tasks         Json? // String[] — qué quiere que haga la IA
  ai_never_replace Json? // String[] — qué jamás debe reemplazar la IA

  // Perfil generado (post-análisis con Claude)
  tone_description    String? // Descripción del tono del fundador
  leadership_style    String? // Estilo de liderazgo detectado
  operating_style     String? // Cómo opera el fundador
  key_obsessions      Json?   // String[] — en qué se enfoca obsesivamente
  decision_principles Json?   // {situation: string, principle: string}[]

  // Instrucciones generadas para Atlas
  atlas_instructions  String? // @db.Text — system prompt personalizado para Atlas
  atlas_calibrated_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Layer 4 — Communication Mirroring
model CommunicationProfile {
  id        String @id @default(cuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Características detectadas
  tone      String? // formal | semiformal | casual | cálido | directo
  energy    String? // alto | medio | bajo
  formality String? // alta | media | baja
  structure String? // bullets | párrafos | conversacional | mixto
  avg_length String? // breve | medio | extenso

  // Vocabulario
  key_phrases   Json? // String[] — frases que usa la empresa
  avoid_phrases Json? // String[] — frases que nunca usan
  custom_vocab  Json? // {original: string, preferred: string}[]

  // Muestras de comunicación (raw — fuente de entrenamiento)
  samples Json? // {type: 'whatsapp'|'email'|'proposal'|'internal'|'call', content: string, label?: string}[]

  // Análisis extraído por Claude
  extracted_patterns Json?  // análisis estructurado completo
  voice_summary      String? // resumen en lenguaje natural (se inyecta en prompts de agentes)

  // Estado de calibración
  samples_count       Int      @default(0)
  calibration_quality String?  // none | low | medium | high
  last_calibrated_at  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Layer 3 — Culture Translation Blueprint
model CultureBlueprint {
  id        String @id @default(cuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Declaraciones de filosofía (raw — lo que dijo el fundador)
  philosophy_statements Json? // String[]

  // Reglas operativas derivadas (filosofía → comportamiento concreto)
  operational_rules Json? // {trigger: string, expected_behavior: string, metric?: string, owner?: string}[]

  // Estándares de respuesta por canal
  response_standards Json? // {channel: string, max_hours: number, note?: string}[]

  // Marcos de decisión
  decision_frameworks Json? // {situation: string, principle: string, action: string}[]

  // Vocabulario / glosario corporativo específico de esta empresa
  company_language Json? // {term: string, meaning: string, context?: string}[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Layer 2 — Company Operating Map
model OperatingMap {
  id        String @id @default(cuid())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Inventario de sistemas actuales en uso
  current_systems Json? // {name: string, category: string, used_for: string, status?: 'active'|'migrating'|'replacing'}[]

  // Procesos clave del negocio
  key_processes Json? // {name: string, owner_name: string, steps: string[], friction: string[], ai_potential?: string}[]

  // Puntos de dolor identificados
  pain_points Json? // {area: string, description: string, impact: 'high'|'medium'|'low'}[]

  // Health Score del Culture Engine (0-100, calculado)
  health_score     Int?
  health_breakdown Json? // {layer: int, label: string, score: int, max: int, status: string, missing: string[]}[]
  last_health_check DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

