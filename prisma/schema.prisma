  tenant_id          String
  manager_slot_id    String   @unique
  manager_slot       TeamSlot @relation(fields: [manager_slot_id], references: [id], onDelete: Cascade)
  threshold1_periods Int      @default(4)
  threshold1_levels  Int      @default(2)
  threshold2_periods Int      @default(8)
  threshold2_levels  Int      @default(3)
  rationale          String?
  updated_at         DateTime @updatedAt

  @@index([tenant_id])
}

model GoalMeasurement {
  id                             String           @id @default(cuid())
  ksf_id                         String
  ksf                            KeySuccessFactor @relation(fields: [ksf_id], references: [id], onDelete: Cascade)
