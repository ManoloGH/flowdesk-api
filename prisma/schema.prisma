  @@index([relationship_id])
}

model KeySuccessFactor {
  id                 String               @id @default(cuid())
  tenant_id          String
  tenant             Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name               String
  description        String?
  unit               String
  level              KsfLevel
  purpose_id         String?
  purpose            StrategicPurpose?    @relation(fields: [purpose_id], references: [id])
  parent_ksf_id      String?
  parent_ksf         KeySuccessFactor?    @relation("KsfHierarchy", fields: [parent_ksf_id], references: [id])
  child_ksfs         KeySuccessFactor[]   @relation("KsfHierarchy")
  dept_id            String?
  dept               Department?          @relation(fields: [dept_id], references: [id])
  team_slot_id       String?
  team_slot          TeamSlot?            @relation(fields: [team_slot_id], references: [id])
  origin             KsfOrigin
  category           KsfCategory
  success_area_id    String?
  success_area       SuccessArea?         @relation(fields: [success_area_id], references: [id])
  measurement_source MeasurementSource
  measurement_config Json
  measurement_freq   MeasurementFrequency
  minimum_level      Float
  satisfactory_level Float
  outstanding_level  Float
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  milestones    KsfMilestone[]
  measurements  GoalMeasurement[]

  @@index([tenant_id, level])
  @@index([team_slot_id])
  @@index([dept_id])
  @@index([parent_ksf_id])
}

model KsfMilestone {
  id           String           @id @default(cuid())
