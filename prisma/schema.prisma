  owner_phone           String   // número WhatsApp del owner (sin +, sin @)
  evolution_instance    String?  // nombre de la instancia Evolution API
  morning_brief_time    String   @default("08:00")  // HH:MM hora local
  morning_brief_enabled Boolean  @default(true)
  enabled               Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model PendingApproval {
  id           String    @id @default(cuid())
  tenant_id    String
  tenant       Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  requested_by String    // slot_id del agente o humano que pide aprobación
  description  String
  context      Json      @default("{}")
  status       String    @default("pending")  // "pending" | "approved" | "rejected"
  decided_by   String?
  decided_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([tenant_id, status])
}

model DelegationHistory {
  id         String   @id @default(cuid())
  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_slot  String
  to_slot    String
  task       String
  result     String?
  created_at DateTime @default(now())

  @@index([tenant_id])
}

model WorkReport {
  id         String   @id @default(cuid())
  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  slot_id    String
  period     String   // "daily" | "weekly"
  content    Json     @default("{}")
  created_at DateTime @default(now())

  @@index([tenant_id, slot_id])
  @@index([tenant_id, period])
}

// ═════════════════════════════════════════════
// EMPRESA BRAIN — Base de conocimiento vectorial
// ═════════════════════════════════════════════

model EmpresaBrainDocument {
  id          String   @id @default(cuid())
  tenant_id   String
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  source_type String   // "onboarding" | "sop" | "conversation" | "document" | "decision" | "culture" | "goal"
  source_id   String?  // ID del objeto origen
  title       String
  content     String
  embedding   Unsupported("vector(1536)")?
  metadata    Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([tenant_id, source_type])
}

// ═════════════════════════════════════════════
// VAULT — Credenciales cifradas AES-256-GCM
// ═════════════════════════════════════════════

model VaultEntry {
  id              String   @id @default(cuid())
  tenant_id       String
  tenant          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  key_name        String   // "EVOLUTION_API_KEY" | "STRIPE_SECRET" | "GOOGLE_OAUTH_TOKEN" etc.
  encrypted_value String   // AES-256-GCM: iv:tag:data (via EncryptionService)
  category        String   // "whatsapp" | "email" | "billing" | "calendar" | "crm" | "storage" | "other"
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  access_logs VaultAccessLog[]

  @@unique([tenant_id, key_name])
  @@index([tenant_id, category])
}

model VaultAccessLog {
  id         String     @id @default(cuid())
  entry_id   String
  entry      VaultEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  accessor   String     // "system" | slot_id
  action     String     // "read" | "write" | "delete"
  created_at DateTime   @default(now())

  @@index([entry_id])
}

// ── War Room — Reuniones grabadas ─────────────────────────────────────────────
model Meeting {
  id            String    @id @default(cuid())
  tenant_id     String
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_by    String    // TeamSlot.id

  title         String    @default("Reunión")
  platform      String    @default("otro") // zoom | meet | teams | otro
  started_at    DateTime
  ended_at      DateTime?
  duration_secs Int?

  transcript    Json      @default("[]")  // TranscriptSegment[]
  speaker_map   Json      @default("{}")  // {speakerIndex: name}
  summary       String?
  action_items  Json      @default("[]")  // string[]
  doc_url       String?                   // Google Drive doc URL

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([tenant_id])
}

// ─────────────────────────────────────────────
// PBX — REGISTRO DE LLAMADAS
// ─────────────────────────────────────────────
model PhoneCall {
  id              String     @id @default(cuid())
  tenant_id       String
  tenant          Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_number     String
  to_extension    String?
  handled_by_id   String?
  handled_by      TeamSlot?  @relation(fields: [handled_by_id], references: [id])
  status          CallStatus @default(INCOMING)
  duration_sec    Int?
  ai_transcript   String?
  started_at      DateTime   @default(now())
  answered_at     DateTime?
  ended_at        DateTime?

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@map("calls")
}

enum CallStatus {
  INCOMING
  ANSWERED_BY_AI
  TRANSFERRED
  COMPLETED
  MISSED
  VOICEMAIL
}

// ═════════════════════════════════════════════
// APRENDIZAJE DE AGENTES — Propuestas semanales
// ═════════════════════════════════════════════

model AgentLearningProposal {
  id            String   @id @default(cuid())
  tenant_id     String
  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  agent_id      String
  agent         TeamSlot @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  week_start       DateTime
  proposal_type    String   // 'pattern_detected' | 'external_best_practice' | 'master_update'
  summary          String   // resumen legible para el supervisor humano
  proposed_changes Json     // cambios concretos al agent_config o knowledge
  status           String   @default("pending") // pending | approved | rejected | applied
  reviewed_by      String?  // slot_id del supervisor humano que respondió
  reviewed_at      DateTime?
  source_urls      Json?    // URLs de fuentes externas (Firecrawl)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([tenant_id, status])
  @@index([agent_id])
  @@index([tenant_id, week_start])
}

// ═════════════════════════════════════════════
// WEB BUILDER — Proyectos de webs de clientes
// ═════════════════════════════════════════════

model WebProyecto {
  id             String   @id @default(cuid())
  tenant_id      String
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  nombre_cliente String
  slug           String   // kebab-case, ej: "valenciana-mudanzas"
  dominio        String?  // dominio final, ej: "valencianamudanzas.com"
  sector         String?  // mudanzas, fontanería, restaurante, etc.

  // Fase actual del proyecto
  // setup → assets → video → construccion → scroll → seo → publicado → entregado
  fase           String   @default("setup")

  vercel_url        String?
  vercel_project_id String?

  html_original  String?  // HTML original del cliente
  logo_url       String?  // URL del logo subido
  files          Json?    // { 'index.html': '...', 'servicios.html': '...', ... }
  build_log      Json?    // Array de { phase, message, status, ts }
  assets         Json?    // { logo_url, video_url, poster_url }

  notas          String?
  created_by_id  String?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, fase])
  @@unique([tenant_id, slug])
}
