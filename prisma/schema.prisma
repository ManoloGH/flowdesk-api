  updated_at DateTime @updatedAt

  key_success_factors KeySuccessFactor[]
}

model KsfRelationship {
  id               String           @id @default(cuid())
  tenant_id        String
  team_slot_id     String
  team_slot        TeamSlot         @relation(fields: [team_slot_id], references: [id], onDelete: Cascade)
  type             RelationshipType
