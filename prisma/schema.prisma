generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// TENANTS (empresas clientes)
// ─────────────────────────────────────────────
model Tenant {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  logo_url        String?
  primary_color   String  @default("#4F46E5")
  secondary_color String? // second brand color (gradient end)
  tagline         String? // short brand phrase
  industry        String? // sector / vertical
  mission         String?
  vision          String?
  website         String?
  tenant_type     String? @default("company") // company | PLATFORM | NETWORK | BRANCH
  network_id      String? // parent tenant id for branch/franchise
  external_ref    String? // ID de referencia externa (ej: ID proyecto Airtable)

  plan       String @default("starter") // starter | professional | enterprise
  tier       String @default("company") // employee | entrepreneur | company | platform
  max_humans Int    @default(10)
  max_agents Int    @default(20)
  status     String @default("active")

  // Migración a servidor propio
  migration_status  String?   // null | 'bundle_generated' | 'migrated'
  migration_at      DateTime?
  self_hosted_url   String?

  campus_config Json? // { campus_enabled, map_source, map_template, background_color, grid_size }

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  departments          Department[]
  team_slots           TeamSlot[]
  rooms                Room[]
  spaces               Space[]
  schedules            Schedule[]
  messages             Message[]
  files                File[]
  audit_logs           AuditLog[]
  notifications        Notification[]
  integrations         Integration[]
  onboarding_progress  OnboardingProgress?
  contacts             Contact[]
  pipelines            Pipeline[]
  knowledge_bases      KnowledgeBase[]
  courses              Course[]
  reports              Report[]
  calendar_events      CalendarEvent[]
  tasks                Task[]
  goals                Goal[]
  agent_conversations  AgentConversation[]
  agent_memories       AgentMemory[]
  dashboard_configs    DashboardConfig[]
  map_props            MapProp[]
  strategic_purpose    StrategicPurpose?
  key_success_factors  KeySuccessFactor[]
  focus_reports        FocusReport[]
  feedback_reports     FeedbackReport[]
  management_reports   ManagementReport[]
  recognition_events   RecognitionEvent[]
  goal_setup_statuses  GoalSetupStatus[]
  culture_config         CultureConfig?
  culture_principles     CulturePrinciple[]
  culture_rituals        CultureRitual[]
  founder_profile        FounderProfile?
  communication_profile  CommunicationProfile?
  culture_blueprint      CultureBlueprint?
  operating_map          OperatingMap?
  meetings               Meeting[]
  vault_entries          VaultEntry[]
  brain_documents        EmpresaBrainDocument[]
  secretary_config       SecretaryConfig?
  learning_proposals     AgentLearningProposal[]
  billing_config         BillingConfig?
  pending_approvals      PendingApproval[]
  delegation_history     DelegationHistory[]
  work_reports           WorkReport[]
  calls                  PhoneCall[]
  web_proyectos          WebProyecto[]

  // Relaciones de red (PLATFORM → NETWORK → BRANCH)
  network   Tenant?  @relation("NetworkBranches", fields: [network_id], references: [id])
  branches  Tenant[] @relation("NetworkBranches")
}

// ─────────────────────────────────────────────
// DEPARTMENTS
// ─────────────────────────────────────────────
model Department {
  id         String       @id @default(cuid())
  tenant_id  String
  tenant     Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name       String
  dept_type  String? // sales | support | hr | training | ops | delivery | admin | accounting | marketing | bi | management
  color      String       @default("#6366F1")
  icon       String?
  parent_id  String?
  parent     Department?  @relation("DeptHierarchy", fields: [parent_id], references: [id])
  children   Department[] @relation("DeptHierarchy")
  created_at DateTime     @default(now())

  team_slots        TeamSlot[]
  pipelines         Pipeline[]
  knowledge_bases   KnowledgeBase[]
  integrations      Integration[]
  dashboard_configs DashboardConfig[]
  tasks             Task[]
  key_success_factors KeySuccessFactor[]

  @@index([tenant_id])
}

// ─────────────────────────────────────────────
// TEAM SLOTS — humano O agente IA
// ─────────────────────────────────────────────
model TeamSlot {
  id            String      @id @default(cuid())
  tenant_id     String
  tenant        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  department_id String?
  department    Department? @relation(fields: [department_id], references: [id])
  reports_to_id String?
  reports_to    TeamSlot?   @relation("TeamHierarchy", fields: [reports_to_id], references: [id])
  direct_reports TeamSlot[] @relation("TeamHierarchy")

  name          String
  type          SlotType   @default(HUMAN)
  role          String     @default("employee") // owner | admin | manager | employee
  avatar_url    String?
  avatar_config Json?
  status        SlotStatus @default(OFFLINE)
  position_x    Int?
  position_y    Int?

  // Solo humanos
  email           String?   @unique
  password_hash   String?
  access_token    String?   @unique
  whatsapp_phone  String?   // número registrado para acceso al agente vía WhatsApp (ej. "5215512345678")
  schedule_id     String?
  schedule        Schedule? @relation(fields: [schedule_id], references: [id])
  desk_config     Json?   // widget layout / personal desk configuration
  desk_access     String? @default("FULL") // FULL | LIGHT | NONE

  // Solo agentes IA
  agent_config  Json? // { model, instructions, tools[], limits, personality, stt_provider, stt_model, tts_provider, tts_model, tts_voice_id }
  agent_scope   String? // personal | department | company
  agent_role    String? // focus_agent | daily_assistant | department_agent | company_agent | ceo | comunicacion
  owner_slot_id String? // for personal agents: their human owner's slot id
  owner_slot    TeamSlot?  @relation("AgentOwner", fields: [owner_slot_id], references: [id])
  owned_agents  TeamSlot[] @relation("AgentOwner")

  // Aprendizaje y templates
  derived_from_template_id  String?   // slot_id del agente master en tenant PLATFORM
  template_sync_at          DateTime? // última vez que se sincronizó el conocimiento del master

  secretary_config Json?   // { connected_tools[], workflow_templates[], delegation_preferences }
  // PBX Conmutador
  pbx_extension    String?   // extensión SIP Asterisk (ej. "101")
  pbx_sip_password String?   // contraseña SIP cifrada con EncryptionService
  permissions Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sent_messages          Message[]           @relation("SentMessages")
  received_messages      Message[]           @relation("ReceivedMessages")
  time_logs              TimeLog[]
  audit_logs             AuditLog[]
  notifications          Notification[]
  tasks_owned            Task[]              @relation("TaskOwner")
  tasks_assigned         Task[]              @relation("TaskAssignee")
  goals                  Goal[]
  calendar_events        CalendarEvent[]
  contacts_owned         Contact[]
  deals_owned            Deal[]
  agent_memories         AgentMemory[]       @relation("AgentMemories")
  human_memories         AgentMemory[]       @relation("HumanMemories")
  conversations_as_agent AgentConversation[] @relation("AgentConversations")
  conversations_as_human AgentConversation[] @relation("HumanConversations")
  dashboard_configs      DashboardConfig[]
  course_progress        CourseProgress[]
  certifications         Certification[]
  personal_integrations  Integration[]
  ksf_relationships      KsfRelationship[]
  key_success_factors    KeySuccessFactor[]
  escalation_config      EscalationConfig?
  goal_measurements      GoalMeasurement[]
  focus_reports          FocusReport[]
  feedback_reports       FeedbackReport[]
  management_reports     ManagementReport[]
  recognitions_given     RecognitionEvent[]  @relation("RecognizerSlot")
  recognitions_received  RecognitionEvent[]  @relation("RecognizedSlot")
  goal_setup_status      GoalSetupStatus?
  calls_handled          PhoneCall[]
  learning_proposals     AgentLearningProposal[]

  @@index([tenant_id, type])
  @@index([tenant_id, status])
  @@index([email])
  @@index([owner_slot_id])
}

enum SlotType {
  HUMAN
  AI_AGENT
}

enum SlotStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
}

// ─────────────────────────────────────────────
// SCHEDULES (horarios laborales)
// ─────────────────────────────────────────────
model Schedule {
  id                String   @id @default(cuid())
  tenant_id         String
  tenant            Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name              String
  check_in_time     String
  check_out_time    String
  tolerance_minutes Int      @default(15)
  work_days         Json // ["MON","TUE","WED","THU","FRI"]
  created_at        DateTime @default(now())

  team_slots TeamSlot[]

  @@index([tenant_id])
}

// ─────────────────────────────────────────────
// TIME LOGS (reloj checador)
// ─────────────────────────────────────────────
model TimeLog {
  id           String    @id @default(cuid())
  slot_id      String
  slot         TeamSlot  @relation(fields: [slot_id], references: [id], onDelete: Cascade)
  date         String
  check_in     DateTime
  check_out    DateTime?
  status       String    @default("on_time") // on_time | late | early_leave
  location_lat Float?
  location_lng Float?
  device_info  String?
  created_at   DateTime  @default(now())

  @@index([slot_id, date])
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────
model Message {
  id          String    @id @default(cuid())
  tenant_id   String
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sender_id   String
  sender      TeamSlot  @relation("SentMessages", fields: [sender_id], references: [id])
  receiver_id String?
  receiver    TeamSlot? @relation("ReceivedMessages", fields: [receiver_id], references: [id])
  channel_id  String?

  content    String
  type       MessageType @default(CHAT)
  metadata   Json?
  read_at    DateTime?
  created_at DateTime    @default(now())

  @@index([tenant_id, type])
  @@index([sender_id])
  @@index([receiver_id])
  @@index([tenant_id, created_at])
}

enum MessageType {
  CHAT
  EMAIL
  POSTIT
  ANNOUNCEMENT
  AGENT_RESPONSE
}

// ─────────────────────────────────────────────
// ROOMS (mapa de la oficina virtual)
// ─────────────────────────────────────────────
model Room {
  id         String   @id @default(cuid())
  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name       String
  room_type  String // desk | department | meeting | library | break | network | custom
  x          Int
  y          Int
  width      Int
  height     Int
  floor      Int      @default(1)
  color      String   @default("#E0E7FF")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([tenant_id])
}

// ─────────────────────────────────────────────
// SPACES & CAMERAS (espacios físicos con CCTV)
// ─────────────────────────────────────────────
model Space {
  id         String    @id @default(cuid())
  tenant_id  String
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name       String
  type       SpaceType @default(OFFICE)
  floor      Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  cameras Camera[]

  @@index([tenant_id])
}

model Camera {
  id                    String       @id @default(cuid())
  tenant_id             String
  space_id              String
  space                 Space        @relation(fields: [space_id], references: [id], onDelete: Cascade)
  name                  String
  type                  CameraType   @default(MJPEG)
  status                CameraStatus @default(UNKNOWN)
  stream_url_enc        String? // AES-256-GCM encrypted
  snapshot_url_enc      String?
  rtsp_url_enc          String?
  cloud_embed_url       String?
  refresh_interval_secs Int          @default(5)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  @@index([tenant_id])
  @@index([space_id])
}

enum SpaceType {
  OFFICE
  MEETING_ROOM
  RECEPTION
  WAREHOUSE
  EXTERIOR
  OTHER
}

enum CameraType {
  MJPEG
  SNAPSHOT
  RTSP
  CLOUD
}

enum CameraStatus {
  ONLINE
  OFFLINE
  ERROR
  UNKNOWN
}

// ─────────────────────────────────────────────
// FILES
// ─────────────────────────────────────────────
model File {
  id          String   @id @default(cuid())
  tenant_id   String
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  uploader_id String
  name        String
  url         String
  size_bytes  Int
  mime_type   String
  folder_path String   @default("/")
  is_shared   Boolean  @default(false)
  access_list Json?
  created_at  DateTime @default(now())

  @@index([tenant_id])
  @@index([uploader_id])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────
model Notification {
  id         String   @id @default(cuid())
  slot_id    String
  slot       TeamSlot @relation(fields: [slot_id], references: [id], onDelete: Cascade)
  tenant_id  String
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  type       String
  title      String
  content    String
  action_url String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([slot_id, read])
}

// ─────────────────────────────────────────────
// INTEGRATIONS
// ─────────────────────────────────────────────
model Integration {
  id                String      @id @default(cuid())
  tenant_id         String
  tenant            Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  owner_slot_id     String?
  owner_slot        TeamSlot?   @relation(fields: [owner_slot_id], references: [id])
  dept_id           String?
  dept              Department? @relation(fields: [dept_id], references: [id])
  integration_scope String      @default("tenant") // tenant | department | personal
  provider          String // microsoft365 | google | gohighlevel | claude | n8n | whatsapp | stripe | chatwoot | meta
  status            String      @default("disconnected")
  credentials_enc   String?
  scope             Json?
  config            Json?
  last_sync_at      DateTime?
  connected_at      DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  @@index([tenant_id, provider])
  @@index([owner_slot_id])
  @@index([dept_id])
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────
model AuditLog {
  id        String    @id @default(cuid())
  tenant_id String
  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  actor_id  String?
  actor     TeamSlot? @relation(fields: [actor_id], references: [id])

  action        String
  resource_type String
  resource_id   String?
  payload       Json?
  ip_address    String?
  device_info   String?
  timestamp     DateTime @default(now())

  @@index([tenant_id, timestamp])
  @@index([actor_id])
  @@index([tenant_id, action])
  @@index([resource_type, resource_id])
}

// ─────────────────────────────────────────────
// ONBOARDING PROGRESS
// ─────────────────────────────────────────────
model OnboardingProgress {
  id              String    @id @default(cuid())
  tenant_id       String    @unique
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  current_step    Int       @default(0)
  steps_completed Json      @default("[]")
  template_used   String?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// INDUSTRY TEMPLATES (catálogo en BD)
// ─────────────────────────────────────────────
model IndustryTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique
  display_name String
  departments  Json
  rooms        Json
  agent_slots  Json
  created_at   DateTime @default(now())
}

// ═════════════════════════════════════════════
// SEGUNDO CEREBRO — MEMORIA DE AGENTES
// ═════════════════════════════════════════════

model AgentMemory {
  id            String    @id @default(cuid())
  tenant_id     String
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  agent_id      String
  agent         TeamSlot  @relation("AgentMemories", fields: [agent_id], references: [id], onDelete: Cascade)
  owner_slot_id String?
  owner_slot    TeamSlot? @relation("HumanMemories", fields: [owner_slot_id], references: [id])

  memory_type   String // factual | episodic | preference | goal | relationship | skill | context
  content       String
  source_type   String?
  source_id     String?
  importance    Int       @default(5)
  last_accessed DateTime?
  access_count  Int       @default(0)
  expires_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([agent_id])
  @@index([owner_slot_id])
  @@index([tenant_id, memory_type])
  @@index([importance])
}

model AgentConversation {
  id         String    @id @default(cuid())
  tenant_id  String
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  agent_id   String
  agent      TeamSlot  @relation("AgentConversations", fields: [agent_id], references: [id])
  human_id   String
  human      TeamSlot  @relation("HumanConversations", fields: [human_id], references: [id])
  session_id String    @default(cuid())
  context    Json?
  summary    String?
  started_at DateTime  @default(now())
  ended_at   DateTime?
  created_at DateTime  @default(now())

  messages AgentMessage[]

  @@index([agent_id])
  @@index([human_id])
  @@index([tenant_id])
  @@index([session_id])
}

model AgentMessage {
  id              String            @id @default(cuid())
  conversation_id String
  conversation    AgentConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  role            String // user | assistant | system | tool
  content         String
  tool_calls      Json?
  tool_results    Json?
  tokens_used     Int?
  created_at      DateTime          @default(now())

  @@index([conversation_id])
  @@index([conversation_id, created_at])
}

// ═════════════════════════════════════════════
// PRODUCTIVIDAD — TAREAS, METAS, CALENDARIO
// ═════════════════════════════════════════════

model Task {
  id            String      @id @default(cuid())
  tenant_id     String
  tenant        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  owner_id      String
  owner         TeamSlot    @relation("TaskOwner", fields: [owner_id], references: [id])
  assignee_id   String?
  assignee      TeamSlot?   @relation("TaskAssignee", fields: [assignee_id], references: [id])
  department_id String?
  department    Department? @relation(fields: [department_id], references: [id])

  title        String
  description  String?
  status       String    @default("pending") // pending | in_progress | completed | cancelled
  priority     String    @default("medium") // low | medium | high | urgent
  due_date     DateTime?
  completed_at DateTime?
  tags         Json?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([tenant_id, status])
  @@index([owner_id])
  @@index([assignee_id])
  @@index([department_id])
}

model Goal {
  id        String   @id @default(cuid())
  tenant_id String
  tenant    Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  slot_id   String
  slot      TeamSlot @relation(fields: [slot_id], references: [id], onDelete: Cascade)

  title         String
  description   String?
  goal_type     String    @default("personal") // personal | department | company
  target_value  Float?
  current_value Float?
  unit          String?
  period        String    @default("monthly") // daily | weekly | monthly | quarterly | yearly
  start_date    DateTime?
  end_date      DateTime?
  status        String    @default("active") // active | completed | paused | cancelled
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([slot_id])
  @@index([tenant_id, status])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  tenant_id    String
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  organizer_id String
  organizer    TeamSlot @relation(fields: [organizer_id], references: [id])

  title       String
  description String?
  start_at    DateTime
  end_at      DateTime
  all_day     Boolean  @default(false)
  location    String?
  attendees   Json?
  external_id String?
  provider    String? // google | microsoft | internal
  recurrence  Json?
  status      String   @default("confirmed") // confirmed | tentative | cancelled
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([tenant_id])
  @@index([organizer_id])
  @@index([start_at])
}

// ─────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────
model DashboardConfig {
  id        String      @id @default(cuid())
  tenant_id String
  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  slot_id   String?
  slot      TeamSlot?   @relation(fields: [slot_id], references: [id])
  dept_id   String?
  dept      Department? @relation(fields: [dept_id], references: [id])

  name       String
  layout     Json?
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  widgets DashboardWidget[]

  @@index([slot_id])
  @@index([dept_id])
  @@index([tenant_id])
}

model DashboardWidget {
  id           String          @id @default(cuid())
  dashboard_id String
  dashboard    DashboardConfig @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  tenant_id    String

  widget_type String // metric | chart | list | clock | calendar | tasks | pipeline | map | contacts | kpi | agent_chat | team_status | goals
  title       String
  config      Json // data source, filters, display options
  position    Json // { x, y, w, h }
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([dashboard_id])
}

// ═════════════════════════════════════════════
// CRM
// ═════════════════════════════════════════════

model Contact {
  id            String    @id @default(cuid())
  tenant_id     String
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  owner_slot_id String?
  owner_slot    TeamSlot? @relation(fields: [owner_slot_id], references: [id])

  first_name    String
  last_name     String?
  email         String?
  phone         String?
  company       String?
  position      String?
  status        String  @default("lead") // lead | prospect | customer | churned | partner
  tags          Json?
  custom_fields Json?

  ghl_id             String?
  chatwoot_id        String?
  stripe_customer_id String?
  meta_psid          String?

  last_contact_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  activities ContactActivity[]
  deals      Deal[]

  @@index([tenant_id])
  @@index([owner_slot_id])
  @@index([email])
  @@index([phone])
  @@index([tenant_id, status])
}

model ContactActivity {
  id         String  @id @default(cuid())
  contact_id String
  contact    Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  tenant_id  String
  actor_id   String?

  activity_type String // note | call | email | message | meeting | task | deal_update | payment
  content       String
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([contact_id])
  @@index([tenant_id, activity_type])
}

model Pipeline {
  id            String      @id @default(cuid())
  tenant_id     String
  tenant        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  department_id String?
  department    Department? @relation(fields: [department_id], references: [id])

  name          String
  description   String?
  pipeline_type String   @default("sales") // sales | support | hr | custom
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]

  @@index([tenant_id])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipeline_id String
