  period                         DateTime
  actual_value                   Float
  status                         KsfStatus
  trend                          Trend
  consecutive_above_satisfactory Int              @default(0)
  consecutive_below_minimum      Int              @default(0)
  snapshot                       Json?
  created_at                     DateTime         @default(now())

  @@unique([ksf_id, period])
  @@index([ksf_id])
  @@index([team_slot_id])
  @@index([ksf_id, period])
}

model FocusReport {
