# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowdesk"

# JWT
JWT_SECRET="tu-clave-secreta-muy-larga"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_KEY="tu-service-key"

# Encriptación
ENCRYPTION_KEY="clave-de-32-caracteres-minimo"

# ── IA — Estrategia dual (CEO=Claude, Agentes=OpenRouter free) ───────────────

# CEO Digital (Atlas) — siempre Claude por defecto, máxima calidad
ANTHROPIC_API_KEY="sk-ant-..."
CEO_AI_MODEL=claude-sonnet-4-6

# Agentes de la empresa — OpenRouter con modelos gratuitos por defecto
# Registrarse gratis en https://openrouter.com → API Keys
AGENT_AI_PROVIDER=openrouter
AGENT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_AI_API_KEY=sk-or-...

# Alternativa: Ollama local para agentes (sin costo, requiere hardware)
# AGENT_AI_PROVIDER=ollama
# AGENT_AI_MODEL=qwen2.5:7b
# AGENT_AI_BASE_URL=http://localhost:11434/v1

# ── Búsqueda web (para tools web_search y read_url de los agentes) ────────────
# Firecrawl: búsqueda + scraping de alta calidad. https://firecrawl.dev
FIRECRAWL_API_KEY="fc-..."
# Brave Search (alternativa a Firecrawl para búsqueda, sin scraping)
# BRAVE_SEARCH_API_KEY="BSA..."

# Transcripción (War Room)
DEEPGRAM_API_KEY="..."

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:3001/integrations/google/callback"

# Microsoft 365 OAuth (Outlook + Teams)
MS_CLIENT_ID="..."
MS_CLIENT_SECRET="..."
MS_TENANT_ID="common"
MS_REDIRECT_URI="http://localhost:3001/integrations/microsoft/callback"

# Airtable
# PAT: https://airtable.com/create/tokens (scopes: data.records:read, data.records:write, schema.bases:write)
AIRTABLE_PAT=""
# Base ID del ERP Agencia de MentorIA (ej. appXXXXXXXXXXXXXX)
AIRTABLE_ERP_BASE_ID=""

# ── PBX Asterisk ─────────────────────────────────────────────────────────────
# IP pública del VPS donde corre Asterisk (necesario para NAT traversal)
ASTERISK_PUBLIC_IP=1.2.3.4
# localhost porque Asterisk usa network_mode: host en docker-compose
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USER=flowdesk
ASTERISK_ARI_PASSWORD=cambia_esto
ASTERISK_APP=flowdesk
ASTERISK_CONTEXT=from-external
ASTERISK_PSTN_TRUNK=SIP/trunk-twilio

# STT (transcripción de llamadas)
# WHISPER_URL=http://localhost:9000    # Whisper local
# o dejar vacío para usar Deepgram

# TTS (voz en llamadas)
# PIPER_URL=http://localhost:5000     # Piper local

# ── Webhooks ──────────────────────────────────────────────────────────────────
FLOWDESK_WEBHOOK_SECRET="secreto-aleatorio-seguro"

# Frontend (para redirects OAuth)
FRONTEND_URL="http://localhost:3000"
