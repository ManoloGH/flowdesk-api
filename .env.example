# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowdesk"

# JWT
JWT_SECRET="tu-clave-secreta-muy-larga"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_KEY="tu-service-key"

# EncriptaciÃ³n
ENCRYPTION_KEY="clave-de-32-caracteres-minimo"

# â”€â”€ IA â€” Estrategia dual (CEO=Claude, Agentes=OpenRouter free) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# CEO Digital (Atlas) â€” siempre Claude por defecto, mÃ¡xima calidad
ANTHROPIC_API_KEY="sk-ant-..."
