# Agentes de la empresa â€” OpenRouter con modelos gratuitos por defecto
# Registrarse gratis en https://openrouter.com â†’ API Keys
AGENT_AI_PROVIDER=openrouter
AGENT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
